{
  "name": "@praesidia/audit-verifier",
  "version": "0.11.0",
  "description": "Offline verifier CLI for Praesidia compliance bundles. Zero runtime dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "praesidia-verify": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/trust-anchor-verification.md",
    "docs/design/platform-key-hierarchy.md",
    "docs/decision-disclosures.md",
    "scripts/assert-release-trust-anchor.mjs",
    "scripts/check-trust-anchor-ci.mjs",
    "scripts/trust-anchor-policy.mjs",
    "scripts/trust-anchor-policy.selftest.mjs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build && npm run typecheck:spec && npm run check:release-trust-anchor",
    "check:release-trust-anchor": "node scripts/assert-release-trust-anchor.mjs",
    "check:trust-anchor-ci": "node scripts/check-trust-anchor-ci.mjs",
    "test:trust-anchor-policy": "node --test scripts/trust-anchor-policy.selftest.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:spec": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "praesidia",
    "audit",
    "compliance",
    "verifier",
    "ed25519",
    "merkle",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/praesidia-ai/audit-verifier"
  },
  "publishConfig": {
    "access": "public"
  }
}
